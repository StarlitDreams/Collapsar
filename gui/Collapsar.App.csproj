<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Collapsar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Suppress the "no PublishProfile for ARM64" warning when packaging
         the unpackaged WinExe. -->
    <DisableHasPackageBeenInitializedCheck>true</DisableHasPackageBeenInitializedCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.241001000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- The native Collapsar.Bridge DLL is consumed via P/Invoke. We copy it
       (and its zlib dependency) into the GUI's output directory at build
       time so users only need to launch Collapsar.App.exe. -->
  <ItemGroup>
    <None Include="..\build\windows\bin\Release\Collapsar.Bridge.dll"
          Condition="Exists('..\build\windows\bin\Release\Collapsar.Bridge.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Collapsar.Bridge.dll</Link>
    </None>
    <None Include="..\build\windows\bin\Release\z.dll"
          Condition="Exists('..\build\windows\bin\Release\z.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>z.dll</Link>
    </None>
    <None Include="..\build\windows-cuda\bin\Release\Collapsar.Bridge.dll"
          Condition="Exists('..\build\windows-cuda\bin\Release\Collapsar.Bridge.dll') AND !Exists('..\build\windows\bin\Release\Collapsar.Bridge.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Collapsar.Bridge.dll</Link>
    </None>
    <None Include="..\build\windows-cuda\bin\Release\z.dll"
          Condition="Exists('..\build\windows-cuda\bin\Release\z.dll') AND !Exists('..\build\windows\bin\Release\z.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>z.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

</Project>

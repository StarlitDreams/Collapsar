<Window
    x:Class="Collapsar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Collapsar.App.ViewModels"
    Title="Collapsar">
    <Grid Padding="24" RowSpacing="16" ColumnSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE7B8;" FontSize="28" />
            <TextBlock Text="Collapsar" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.GpuStatus, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Bottom" Margin="12,0,0,4" />
        </StackPanel>

        <!-- Input list -->
        <Border Grid.Row="1" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="8" Padding="12">
            <Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Inputs}"
                          SelectionMode="None"
                          IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="Drop files here, or click Add files…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Options -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox Header="Output format"
                      ItemsSource="{x:Bind ViewModel.AvailableFormats}"
                      SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
                      Grid.Column="0" HorizontalAlignment="Stretch" />

            <ComboBox Header="Compression level"
                      ItemsSource="{x:Bind ViewModel.AvailableLevels}"
                      SelectedItem="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}"
                      Grid.Column="1" HorizontalAlignment="Stretch" />

            <ToggleSwitch Header="Use GPU"
                          IsOn="{x:Bind ViewModel.UseGpu, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.GpuAvailable}"
                          OffContent="Off" OnContent="On"
                          Grid.Column="2" />
        </Grid>

        <!-- Progress -->
        <StackPanel Grid.Row="3" Spacing="6">
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="False" />
            <TextBlock Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Add files…"
                    Click="OnAddFilesClicked" />
            <Button Content="Choose output…"
                    Click="OnChooseOutputClicked" />
            <Button Content="Pack"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.PackCommand}" />
            <Button Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
